---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Engineering calculations, directly in Excel', description = site.description, noindex = false } = Astro.props;
const pageTitle = title === 'eeFunction' ? title : `${title} | eeFunction`;
const canonicalUrl = new URL(Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/social-card.svg', site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 이동</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
