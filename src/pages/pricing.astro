---
import BaseLayout from '../layouts/BaseLayout.astro';
const plans=[{name:'Community',label:'Free',status:'Available',description:'기본 함수와 공개 문서를 통해 eeFunction의 핵심 사용 흐름을 제공합니다.',items:['기본 함수군','공개 문서','선별된 예제','커뮤니티 지원']},{name:'Individual',label:'Pro',status:'Pricing TBD',description:'전문 기능과 확장된 공식 예제가 필요한 개인 엔지니어를 위한 계획입니다.',items:['고급 함수군','전체 공식 예제','상용 프로젝트 사용 조건','우선 지원 계획'],featured:true},{name:'Team',label:'Pro',status:'Under design',description:'여러 사용자의 배포와 라이선스 관리를 고려한 팀 상품을 검토 중입니다.',items:['좌석 기반 관리','조직 배포 가이드','팀 지원','구매 증빙']}];
---
<BaseLayout title="Pricing"><section class="page-hero section-dark"><div class="container"><div class="eyebrow"><span></span>Licensing under design</div><h1>Simple plans for<br />individuals and teams.</h1><p>가격과 라이선스 정책은 아직 확정되지 않았습니다. 아래 구성은 출시 준비를 위한 상품 구조 초안입니다.</p></div></section><section class="section container"><div class="price-grid">{plans.map(plan=><article class:list={['price-card',{featured:plan.featured}]}><small>{plan.label}</small><h2>{plan.name}</h2><p><strong>{plan.status}</strong></p><p>{plan.description}</p><ul>{plan.items.map(item=><li>{item}</li>)}</ul></article>)}</div><p class="notice-box">표시된 내용은 최종 판매 조건이 아니며 정식 출시 시 별도 약관과 가격표로 확정합니다.</p></section></BaseLayout>
